@model List<LibServer.Models.ModelBook>
@{
    ViewBag.Title = "Результаты поиска";
}

<p>@Html.ActionLink("Домашняя страница: Поиск книг", "Index")</p>

@if (Model.Count == 0)
{
    <p style="color:red;">Ничего не найдено</p>
}
else
{
    <h1>Результаты поиска</h1>
    <p>Найдено книг: @Model.Count</p>
    
    <table border="1" cellpadding="5">
        <tr>
            <th>Название</th>
            <th>Автор</th>
            <th>Издательство</th>
            <th>Жанр</th>
            <th>Оценка</th>
        </tr>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Publisher</td>
                <td>@book.Genre</td>
                <td>@book.Grade</td>
            </tr>
        }
    </table>
}